{
  "version": "0.1.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "CongXinJian",
    "id": "CongXinJian",
    "version": "0.1.0",
    "url": null,
    "additionalData": {
      "overrideSoName": "libCongXinJian.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "pwsh ./scripts/build.ps1"
      ],
      "clean": [
        "pwsh ./scripts/build.ps1 -clean"
      ],
      "copy": [
        "pwsh ./scripts/copy.ps1 $0:?"
      ],
      "logcat": [
        "pwsh ./scripts/start-logging.ps1"
      ],
      "qmod": [
        "pwsh ./scripts/build.ps1",
        "pwsh ./scripts/createqmod.ps1"
      ],
      "restart": [
        "pwsh ./scripts/restart-game.ps1"
      ],
      "stack": [
        "pwsh ./scripts/ndk-stack.ps1"
      ],
      "tomb": [
        "pwsh ./scripts/pull-tombstone.ps1"
      ]
    },
    "ndk": "^29.0.14206865",
    "qmodIncludeDirs": [
      "./build",
      "./extern/libs"
    ],
    "qmodIncludeFiles": [],
    "qmodOutput": "./CongXinJian.qmod"
  },
  "dependencies": [
    {
      "id": "scotland2",
      "versionRange": "^0.1.7",
      "additionalData": {
        "includeQmod": false
      }
    },
    {
      "id": "beatsaber-hook",
      "versionRange": "^8.2.1",
      "additionalData": {}
    },
    {
      "id": "bs-cordl",
      "versionRange": "^4500.1.0",
      "additionalData": {}
    },
    {
      "id": "bsml",
      "versionRange": "^0.5.8",
      "additionalData": {}
    },
    {
      "id": "custom-types",
      "versionRange": "^0.20.1",
      "additionalData": {}
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.8.0",
      "additionalData": {}
    },
    {
      "id": "flamingo",
      "versionRange": "^1.2.1",
      "additionalData": {}
    }
  ]
}
